<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>BOUTOU FARM V9 - Logiciel Libre</title>
<link rel="manifest" href="manifest.json">
<meta name="theme-color" content="#2E7D32">
<meta name="mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
<style>
*{box-sizing:border-box;font-family:system-ui,Arial}
body{margin:0;color:#222;min-height:100vh;background:linear-gradient(rgba(255,255,255,.88),rgba(241,248,233,.92)),url('https://unsplash.com');background-size:cover;background-attachment:fixed}
header{background:linear-gradient(135deg,#1B5E20,#2E7D32,#66BB6A);color:#fff;padding:18px 14px;text-align:center;box-shadow:0 4px 20px rgba(0,0,0,.2)}
header h1{margin:0;font-size:22px}
header p{margin:6px 0 0;font-size:13px;opacity:.95}
.wrap{max-width:1020px;margin:auto;padding:12px}
.card{background:rgba(255,255,255,.96);border:1px solid #E8F5E9;border-radius:18px;padding:16px;margin:12px 0;box-shadow:0 6px 20px rgba(46,125,50,.10)}
h2{margin:0 0 12px;color:#1B5E20;font-size:19px}
h3{margin:16px 0 8px;color:#33691E}
input,select,textarea{width:100%;padding:12px;margin:6px 0;border:1.5px solid #C8E6C9;border-radius:12px;font-size:15px;background:#fff}
button{padding:12px 16px;border:0;border-radius:999px;font-weight:700;cursor:pointer;font-size:14px;box-shadow:0 3px 10px rgba(0,0,0,.12)}
button:active{transform:scale(.97)}
.b-green{background:linear-gradient(135deg,#2E7D32,#66BB6A);color:#fff}
.b-orange{background:linear-gradient(135deg,#EF6C00,#FFB74D);color:#fff}
.b-blue{background:linear-gradient(135deg,#1565C0,#64B5F6);color:#fff}
.b-purple{background:linear-gradient(135deg,#6A1B9A,#BA68C8);color:#fff}
.b-grey{background:#ECEFF1;color:#37474F;box-shadow:none;border:1px solid #CFD8DC}
.b-red{background:#fff;color:#C62828;border:1.5px solid #FFCDD2;box-shadow:none;padding:8px 12px;font-size:13px}
.install{background:linear-gradient(135deg,#FF8F00,#FFC107);color:#fff;width:100%;padding:14px;font-size:16px;margin:10px 0;display:none}
.row{display:flex;gap:10px;flex-wrap:wrap}.row>*{flex:1;min-width:140px}
.tabs{display:flex;gap:8px;flex-wrap:wrap;margin:12px 0}
.tabs button{background:#fff;border:1.5px solid #C8E6C9;color:#2E7D32;padding:10px 13px}
.tabs button.on{background:linear-gradient(135deg,#2E7D32,#66BB6A);color:#fff}
.item{border:1px solid #E8F5E9;border-left:5px solid #66BB6A;border-radius:14px;padding:12px;margin:10px 0;background:linear-gradient(180deg,#fff,#F9FBE7)}
.small{font-size:13px;color:#666}
.badge{display:inline-block;padding:4px 10px;border-radius:999px;font-size:12px;font-weight:700;background:#E8F5E9;color:#2E7D32;border:1px solid #C8E6C9}
.badge-orange{background:#FFF3E0;color:#EF6C00;border-color:#FFE0B2}
.ai{background:linear-gradient(135deg,#FFF8E1,#FFFDE7);border:1.5px solid #FFE082;border-radius:16px;padding:14px;margin:12px 0}
.ai2{background:linear-gradient(135deg,#EDE7F6,#F3E5F5);border:1.5px solid #CE93D8;border-radius:16px;padding:14px;margin:12px 0}
.flex{display:flex;justify-content:space-between;align-items:center;gap:10px;flex-wrap:wrap}
.stat{text-align:center}
@media print{.no-print{display:none}body{background:#fff}}
</style>
</head>
<body>
<header>
  <h1>🌿 BOUTOU FARM • Logiciel Libre</h1>
  <p>Portail • Ouvrier • Élevage • Agriculture • Compta • IA Conseiller • Journal Mensuel</p>
  <p id="offlineBadge" style="font-size:12px;background:rgba(255,255,255,.2);display:inline-block;padding:4px 10px;border-radius:999px">🟢 En ligne</p>
</header>
<div class="wrap">
  <button id="installBtn" class="install" onclick="installerApp()">📲 Installer Boutou Farm sur ce téléphone / ordinateur</button>
  
  <div id="login" class="card" style="text-align:center;max-width:500px;margin:20px auto">
    <h2>🔐 Entre ton code</h2>
    <p class="small">Gestionnaire : <b>9999</b> • Ouvriers : <b>1111</b> Moussa, <b>2222</b> Aïcha</p>
    <input id="code" type="password" inputmode="numeric" placeholder="Ex : 9999" maxlength="6" onkeydown="if(event.key==='Enter') doLogin()">
    <button class="b-green" style="width:100%;padding:14px" onclick="doLogin()">Entrer ➜</button>
    <p class="small" style="background:#F1F8E9;padding:8px;border-radius:10px">🌳 Manguiers • 🌽 Maïs • 🐄 Bovins • 🐖 Porcs • 🐓 Volailles • 🐟 Poissons • 🐝 Abeilles • 🪱 Asticots</p>
    <p class="small">Logiciel Libre GPL v3 • Fonctionne sans internet après installation • Données stockées sur l'appareil</p>
  </div>

  <div id="app" style="display:none">
    <div class="flex">
      <div><b id="who" style="font-size:17px"></b><br><span class="small" id="whoSub"></span></div>
      <button class="b-grey" onclick="logout()">↩ Déconnexion</button>
    </div>
    <div id="aiBox" class="ai"></div>
    <div id="aiAlertBox" class="ai2"></div>
    
    <div id="tabsManager" class="tabs no-print">
      <button onclick="showTab('dash',this)" class="on">📊 Tableau de bord</button>
      <button onclick="showTab('ouvrier',this)">👷 Ouvrier</button>
      <button onclick="showTab('agri',this)">🌱 Agriculture</button>
      <button onclick="showTab('elevage',this)">🐄 Élevage</button>
      <button onclick="showTab('compta',this)">💰 Ventes & Compta</button>
      <button onclick="showTab('journal',this)">📓 Journal Mensuel</button>
      <button onclick="showTab('ia',this)">🤖 IA Conseiller</button>
    </div>

    <div id="tab-dash" class="card tab">
      <h2>📊 Tableau de bord Gestionnaire - Portail</h2>
      <div class="row">
        <div class="card stat" style="margin:0">🌳 Pérennes<br><b id="cPer" style="font-size:26px;color:#2E7D32">0</b></div>
        <div class="card stat" style="margin:0">🌱 Saisonnières<br><b id="cSai" style="font-size:26px;color:#EF6C00">0</b></div>
        <div class="card stat" style="margin:0">🐄 Lots Élevage<br><b id="cEle" style="font-size:26px;color:#1565C0">0</b></div>
        <div class="card stat" style="margin:0">👷 Ouvriers<br><b id="cPers" style="font-size:26px">0</b></div>
        <div class="card stat" style="margin:0">💰 Solde Mois<br><b id="cSolde" style="font-size:20px;color:#2E7D32">0 F</b></div>
      </div>
      <h3>✅ Aujourd'hui - Qui a validé ?</h3>
      <div id="dashToday"></div>
      <h3>🤖 Résumé IA du mois en 1 phrase</h3>
      <div id="resumeIA" class="ai"></div>
    </div>

    <div id="tab-ouvrier" class="card tab" style="display:none">
      <h2>👷 Tableau de bord Ouvrier</h2>
      <div class="no-print">
        <h3>Ajouter ouvrier</h3>
        <div class="row"><input id="uNom" placeholder="Nom : Moussa"><input id="uRole" placeholder="Poste : Berger, Champ"></div>
        <button class="b-green" onclick="addUser()">👷 + Ajouter + Générer code</button>
      </div>
      <div id="listPers"></div>
      <div class="no-print">
        <h3>Assigner Tâche</h3>
        <div class="row"><select id="tUser"></select><select id="tBloc"><option>Pérenne</option><option>Saisonnier</option><option>Élevage</option><option>Divers</option></select></div>
        <input id="tLib" placeholder="Ex : Arroser manguiers P2">
        <div class="row"><select id="tPerio"><option>Tous les jours</option><option>Tous les 2 jours</option><option>Chaque lundi</option><option>Chaque mois</option></select><input id="tHeure" placeholder="Heure : 07:00"></div>
        <button class="b-green" onclick="addTache()">✅ + Assigner tâche</button>
      </div>
      <div id="listTaches"></div>
      <div class="no-print">
        <h3>Paiement Ouvrier</h3>
        <div class="row"><select id="pUser"></select><input id="pMontant" type="number" placeholder="Montant F"><input id="pMotif" placeholder="Motif : Salaire novembre"></div>
        <button class="b-orange" onclick="addPaiement()">💰 Enregistrer paiement</button>
      </div>
      <div id="listPaiements"></div>
    </div>
    <div id="tab-agri" class="card tab" style="display:none">
      <h2>🌱 Tableau de bord Agriculture - Parcelles + Cultures + Récoltes</h2>
      <div class="no-print">
        <h3>Parcelle</h3>
        <div class="row"><input id="parNom" placeholder="Parcelle : P1"><input id="parSurf" placeholder="Surface ha : 2"></div>
        <button class="b-grey" onclick="addParcelle()">+ Ajouter parcelle</button>
        <div id="listParcelle"></div>
        <h3>Culture - Pérenne / Saisonnière</h3>
        <div class="row"><select id="cuParcelle"></select><select id="cuType"><option>Pérenne</option><option>Saisonnière</option></select></div>
        <div class="row"><input id="cuNom" placeholder="Manguier, Maïs, Manioc..."><input id="cuPieds" type="number" placeholder="Nombre pieds / Qté semée"></div>
        <div class="row"><input id="cuSemis" type="date"><input id="cuRecoltePrev" type="date"></div>
        <button class="b-green" onclick="addCulture()">🌱 + Ajouter culture</button>
      </div>
      <div id="listCultures"></div>
      <div class="no-print">
        <h3>Entretien</h3>
        <div class="row"><select id="eCu"></select><select id="eType"><option>Labour</option><option>Arrosage</option><option>Taille</option><option>Traitement</option><option>Désherbage</option></select></div>
        <input id="eDesc" placeholder="Détail : ex Labour P3, 12/11">
        <button class="b-blue" onclick="addEntretien()">+ Ajouter entretien</button>
      </div>
      <div id="listEntretiens"></div>
      <div class="no-print">
        <h3>Récolte</h3>
        <div class="row"><select id="rCu"></select><input id="rQte" type="number" placeholder="Quantité kg"><input id="rDate" type="date"></div>
        <button class="b-orange" onclick="addRecolte()">🌾 + Ajouter récolte</button>
      </div>
      <div id="listRecoltes"></div>
    </div>

    <div id="tab-elevage" class="card tab" style="display:none">
      <h2>🐄 Tableau de bord Élevage - 3 Familles</h2>
      <div class="no-print">
        <div class="row"><select id="elFam"><option>Polygastriques</option><option>Monogastriques</option><option>Autres</option></select><select id="elEsp"><option>Bovins</option><option>Ovins</option><option>Caprins</option><option>Porcs</option><option>Volailles</option><option>Lapins</option><option>Poissons</option><option>Abeilles</option><option>Asticots</option></select></div>
        <div class="row"><input id="elLot" placeholder="Lot : Lot A Vaches"><input id="elEff" type="number" placeholder="Effectif"></div>
        <input id="elStock" type="number" placeholder="Stock aliment sacs : ex 10">
        <button class="b-blue" onclick="addLot()">🐄 + Ajouter lot</button>
      </div>
      <div id="listLots"></div>
      <div class="no-print">
        <h3>Alimentation + Soin + Mouvement Effectif</h3>
        <div class="row"><select id="alLot"></select><input id="alQte" placeholder="Ration : ex 2 sacs / jour"><input id="alDate" type="date"></div>
        <button class="b-green" onclick="addAlim()">🥣 + Alimentation</button>
        <div class="row"><input id="soinDesc" placeholder="Soin : Vaccin, Vermifuge"><input id="soinMort" type="number" placeholder="Mortalité : 0"></div>
        <button class="b-orange" onclick="addSoin()">🩺 + Soin / Mortalité</button>
      </div>
      <div id="listAlimSoin"></div>
    </div>

    <div id="tab-compta" class="card tab" style="display:none">
      <h2>💰 Ventes & Compta</h2>
      <div class="no-print">
        <div class="row"><select id="vType"><option>Récolte</option><option>Animal</option><option>Autre</option></select><input id="vProd" placeholder="Produit : Maïs, Porc, Mangue"></div>
        <div class="row"><input id="vClient" placeholder="Client : Marché Maroua"><input id="vQte" type="number" placeholder="Quantité"><input id="vMontant" type="number" placeholder="Montant F"></div>
        <button class="b-green" onclick="addVente()">💰 + Enregistrer vente</button>
        <h3>Dépense</h3>
        <div class="row"><input id="dDesc" placeholder="Dépense : Achat aliment"><input id="dMontant" type="number" placeholder="Montant F"></div>
        <button class="b-red" onclick="addDepense()">➖ + Enregistrer dépense</button>
      </div>
      <div id="listVentes"></div>
      <h3>Coût par lot (IA Argent)</h3>
      <div id="coutLots"></div>
    </div>

    <div id="tab-journal" class="card tab" style="display:none">
      <h2>📓 Journal Mensuel - Compilation automatique</h2>
      <div class="row no-print"><input id="jMois" type="month"><button class="b-blue" onclick="render()">Filtrer</button><button class="b-grey" onclick="window.print()">🖨️ Imprimer / PDF</button></div>
      <div id="listJournal"></div>
    </div>

    <div id="tab-ia" class="card tab" style="display:none">
      <h2>🤖 IA Conseiller Boutou - Pose ta question</h2>
      <p class="small">Exemples : "que doivent faire mes ouvriers demain ?" • "combien j'ai gagné ?" • "quelle parcelle est libre ?" • "quand récolter mon maïs ?" • "stock aliment porcs ?"</p>
      <input id="qIA" placeholder="Écris ta question ici..." onkeydown="if(event.key==='Enter') askIA()">
      <button class="b-purple" style="width:100%" onclick="askIA()">🤖 Demander à l'IA</button>
      <div id="repIA" class="ai2"></div>
      <h3>🌦️ Météo Maroua - IA</h3>
      <div id="meteoIA" class="ai">Chargement météo...</div>
      <h3>🔍 Diagnostic Plante / Animal</h3>
      <input id="diagTxt" placeholder="Décris : feuille jaune, porc ne mange pas...">
      <button class="b-orange" onclick="diagnostic()">🔍 Diagnostiquer</button>
      <div id="diagRep" class="ai"></div>
    </div>

    <div id="vueOuvrier" class="card" style="display:none">
      <h2>👷 Mes tâches du jour</h2>
      <p class="small">Tu ne vois que TES tâches.</p>
      <div id="listMesTaches"></div>
      <h3>📝 Mon historique</h3>
      <div id="histOuvrier"></div>
    </div>
  </div>
</div>

<script>
// 1. GESTION PWA, MODE HORS-LIGNE ET BOUTON INSTALLER
let deferredPrompt;
window.addEventListener('beforeinstallprompt', e => {
  e.preventDefault();
  deferredPrompt = e;
  document.getElementById('installBtn').style.display = 'block';
});
function installerApp() {
  if (!deferredPrompt) return alert("Utilise le menu de ton navigateur (⋮) puis 'Ajouter à l'écran d'accueil'.");
  deferredPrompt.prompt();
  deferredPrompt.userChoice.then(() => {
    deferredPrompt = null;
    document.getElementById('installBtn').style.display = 'none';
  });
}
function updateOnlineStatus() {
  const b = document.getElementById('offlineBadge');
  if (navigator.onLine) { b.textContent = '🟢 En ligne'; }
  else { b.textContent = '🟠 Mode hors-ligne actif'; }
}
window.addEventListener('online', updateOnlineStatus);
window.addEventListener('offline', updateOnlineStatus);
updateOnlineStatus();

if ('serviceWorker' in navigator) {
  navigator.serviceWorker.register('./sw.js').catch(err => console.log('SW:', err));
}

// 2. BASE DE DONNÉES LOCALE
let DB = {
  parcelles: [{nom:'P1',surf:'2'},{nom:'P2',surf:'1.5'},{nom:'P3',surf:'3'}],
  cultures: [{parcelle:'P1',type:'Pérenne',nom:'Manguier',pieds:40,semis:'2024-03-10',recoltePrev:'2026-12-15'},{parcelle:'P3',type:'Saisonnière',nom:'Maïs',pieds:50,semis:'2026-10-01',recoltePrev:'2026-12-20'}],
  entretiens: [{culture:'Manguier',type:'Arrosage',desc:'Arrosage P1'}],
  recoltes: [{culture:'Maïs',qte:200,date:'2026-11-05'}],
  lots: [{fam:'Polygastriques',esp:'Bovins',lot:'Lot A - Vaches',eff:12,stock:10},{fam:'Monogastriques',esp:'Porcs',lot:'Lot Porcs',eff:18,stock:6},{fam:'Autres',esp:'Poissons',lot:'Étang 1',eff:500,stock:20},{fam:'Autres',esp:'Abeilles',lot:'Ruches P1',eff:8,stock:0}],
  alims: [], soins: [],
  users: [{nom:'Moussa',role:'Berger',code:'1111',actif:true},{nom:'Aïcha',role:'Champ',code:'2222',actif:true}],
  taches: [{user:'Moussa',bloc:'Élevage',lib:'Nourrir les porcs',perio:'Tous les jours',heure:'07:00'},{user:'Moussa',bloc:'Pérenne',lib:'Arroser les manguiers parcelle 2',perio:'Tous les 2 jours',heure:'08:00'},{user:'Aïcha',bloc:'Saisonnier',lib:'Désherber maïs P3',perio:'Chaque lundi',heure:'07:30'}],
  validations: [], paiements: [],
  ventes: [{type:'Récolte',prod:'Maïs',client:'Marché Maroua',qte:200,montant:80000,date:'2026-11-05'}],
  depenses: [{desc:'Achat aliment porcs',montant:45000,date:'2026-11-02'}]
};
try { let s = localStorage.getItem('boutou_v8'); if (s) DB = JSON.parse(s); } catch (e) {}
function save() { try { localStorage.setItem('boutou_v8', JSON.stringify(DB)); } catch (e) {} }

let current = null;
function todayStr() { return new Date().toISOString().slice(0, 10); }
function isDue(t, d) {
  if (t.perio === 'Tous les jours') return true;
  if (t.perio === 'Tous les 2 jours') return new Date(d).getDate() % 2 === 0;
  if (t.perio === 'Chaque lundi') return new Date(d).getDay() === 1;
  if (t.perio === 'Chaque mois') return new Date(d).getDate() === 1;
  return true;
}
function v(id) { return document.getElementById(id).value.trim(); }
function clearIds(ids) { ids.forEach(id => { if (document.getElementById(id)) document.getElementById(id).value = ''; }); }

// 3. CONNEXION ET NAVIGATION
function doLogin() {
  let c = v('code');
  if (c === '9999') current = {nom:'Gestionnaire', role:'Gestionnaire', code:'9999'};
  else {
    let u = DB.users.find(x => x.code === c && x.actif);
    if (!u) return alert('Code inconnu ou bloqué. Essaie 9999, 1111 ou 2222.');
    current = u;
  }
  document.getElementById('login').style.display = 'none';
  document.getElementById('app').style.display = 'block';
  document.getElementById('who').textContent = 'Bonjour ' + current.nom + ' • ' + current.role;
  document.getElementById('whoSub').textContent = current.role === 'Gestionnaire' ? 'Tu contrôles tout Boutou' : 'Code : ' + current.code + ' - Tu ne vois que tes tâches';
  if (current.role === 'Gestionnaire') {
    document.getElementById('tabsManager').style.display = 'flex';
