<style>
*{box-sizing:border-box;font-family:system-ui,Arial}body{margin:0;color:#222;min-height:100vh;background:linear-gradient(rgba(255,255,255,.88),rgba(241,248,233,.92)),url('https://images.unsplash.com/photo-1500937386664-56d1dfef3854?w=1200&q=80');background-size:cover;background-attachment:fixed}
header{background:linear-gradient(135deg,#1B5E20,#2E7D32,#66BB6A);color:#fff;padding:18px 14px;text-align:center;box-shadow:0 4px 20px rgba(0,0,0,.2)}
header h1{margin:0;font-size:22px}header p{margin:6px 0 0;font-size:13px;opacity:.95}
.wrap{max-width:1020px;margin:auto;padding:12px}.card{background:rgba(255,255,255,.96);border:1px solid #E8F5E9;border-radius:18px;padding:16px;margin:12px 0;box-shadow:0 6px 20px rgba(46,125,50,.10)}
h2{margin:0 0 12px;color:#1B5E20;font-size:19px}h3{margin:16px 0 8px;color:#33691E}
input,select,textarea{width:100%;padding:12px;margin:6px 0;border:1.5px solid #C8E6C9;border-radius:12px;font-size:15px;background:#fff}
button{padding:12px 16px;border:0;border-radius:999px;font-weight:700;cursor:pointer;font-size:14px;box-shadow:0 3px 10px rgba(0,0,0,.12)}button:active{transform:scale(.97)}
.b-green{background:linear-gradient(135deg,#2E7D32,#66BB6A);color:#fff}.b-orange{background:linear-gradient(135deg,#EF6C00,#FFB74D);color:#fff}.b-blue{background:linear-gradient(135deg,#1565C0,#64B5F6);color:#fff}.b-purple{background:linear-gradient(135deg,#6A1B9A,#BA68C8);color:#fff}.b-grey{background:#ECEFF1;color:#37474F;box-shadow:none;border:1px solid #CFD8DC}.b-red{background:#fff;color:#C62828;border:1.5px solid #FFCDD2;box-shadow:none;padding:8px 12px;font-size:13px}
.install{background:linear-gradient(135deg,#FF8F00,#FFC107);color:#fff;width:100%;padding:14px;font-size:16px;margin:10px 0;display:none}
.row{display:flex;gap:10px;flex-wrap:wrap}.row>*{flex:1;min-width:140px}
.tabs{display:flex;gap:8px;flex-wrap:wrap;margin:12px 0}.tabs button{background:#fff;border:1.5px solid #C8E6C9;color:#2E7D32;padding:10px 13px}.tabs button.on{background:linear-gradient(135deg,#2E7D32,#66BB6A);color:#fff}
.item{border:1px solid #E8F5E9;border-left:5px solid #66BB6A;border-radius:14px;padding:12px;margin:10px 0;background:linear-gradient(180deg,#fff,#F9FBE7)}
.small{font-size:13px;color:#666}.badge{display:inline-block;padding:4px 10px;border-radius:999px;font-size:12px;font-weight:700;background:#E8F5E9;color:#2E7D32;border:1px solid #C8E6C9}.badge-orange{background:#FFF3E0;color:#EF6C00;border-color:#FFE0B2}.badge-blue{background:#E3F2FD;color:#1565C0;border-color:#BBDEFB}
.ai{background:linear-gradient(135deg,#FFF8E1,#FFFDE7);border:1.5px solid #FFE082;border-radius:16px;padding:14px;margin:12px 0}.ai2{background:linear-gradient(135deg,#EDE7F6,#F3E5F5);border:1.5px solid #CE93D8;border-radius:16px;padding:14px;margin:12px 0}
.flex{display:flex;justify-content:space-between;align-items:center;gap:10px;flex-wrap:wrap}.stat{text-align:center}
@media print{.no-print{display:none}body{background:#fff}}
</style></head>
<body>
<header><h1>🌿 BOUTOU FARM V8 • Logiciel Libre</h1><p>Portail • Ouvrier • Élevage • Agriculture • Compta • IA Conseiller • Journal Mensuel</p><p id="offlineBadge" style="font-size:12px;background:rgba(255,255,255,.2);display:inline-block;padding:4px 10px;border-radius:999px">🟢 En ligne</p></header>
<div class="wrap">
<button id="installBtn" class="install" onclick="installerApp()">📲 Installer Boutou Farm sur ce téléphone / ordinateur</button>
<div id="login" class="card" style="text-align:center;max-width:500px;margin:20px auto">
<h2>🔐 Entre ton code</h2><p class="small">Gestionnaire : <b>9999</b> • Ouvriers : <b>1111</b> Moussa, <b>2222</b> Aïcha</p>
<input id="code" type="password" inputmode="numeric" placeholder="Ex : 9999" maxlength="6">
<button class="b-green" style="width:100%;padding:14px" onclick="doLogin()">Entrer ➜</button>
<p class="small" style="background:#F1F8E9;padding:8px;border-radius:10px">🌳 Manguiers • 🌽 Maïs • 🐄 Bovins • 🐖 Porcs • 🐓 Volailles • 🐟 Poissons • 🐝 Abeilles • 🪱 Asticots</p>
<p class="small">Logiciel Libre GPL v3 • Fonctionne sans internet après installation • Données stockées sur l'appareil</p>
</div>
<div id="app" style="display:none">
<div class="flex"><div><b id="who" style="font-size:17px"></b><br><span class="small" id="whoSub"></span></div><button class="b-grey" onclick="logout()">↩ Déconnexion</button></div>
<div id="aiBox" class="ai"></div>
<div id="aiAlertBox" class="ai2"></div>
<div id="tabsManager" class="tabs no-print">
<button onclick="showTab('dash',this)" class="on">📊 Tableau de bord</button>
<button onclick="showTab('ouvrier',this)">👷 Ouvrier</button>
<button onclick="showTab('agri',this)">🌱 Agriculture</button>
<button onclick="showTab('elevage',this)">🐄 Élevage</button>
<button onclick="showTab('compta',this)">💰 Ventes & Compta</button>
<button onclick="showTab('journal',this)">📓 Journal Mensuel</button>
<button onclick="showTab('ia',this)">🤖 IA Conseiller</button>
</div>
<div id="tab-dash" class="card tab"><h2>📊 Tableau de bord Gestionnaire - Portail</h2>
<div class="row"><div class="card stat" style="margin:0">🌳 Pérennes<br><b id="cPer" style="font-size:26px;color:#2E7D32">0</b></div><div class="card stat" style="margin:0">🌱 Saisonnières<br><b id="cSai" style="font-size:26px;color:#EF6C00">0</b></div><div class="card stat" style="margin:0">🐄 Lots Élevage<br><b id="cEle" style="font-size:26px;color:#1565C0">0</b></div><div class="card stat" style="margin:0">👷 Ouvriers<br><b id="cPers" style="font-size:26px">0</b></div><div class="card stat" style="margin:0">💰 Solde Mois<br><b id="cSolde" style="font-size:20px;color:#2E7D32">0 F</b></div></div>
<h3>✅ Aujourd'hui - Qui a validé ?</h3><div id="dashToday"></div><h3>🤖 Résumé IA du mois en 1 phrase</h3><div id="resumeIA" class="ai"></div></div>
<div id="tab-ouvrier" class="card tab" style="display:none"><h2>👷 Tableau de bord Ouvrier</h2>
<div class="no-print"><h3>Ajouter ouvrier</h3><div class="row"><input id="uNom" placeholder="Nom : Moussa"><input id="uRole" placeholder="Poste : Berger, Champ"></div><button class="b-green" onclick="addUser()">👷 + Ajouter + Générer code</button></div><div id="listPers"></div>
<div class="no-print"><h3>Assigner Tâche</h3><div class="row"><select id="tUser"></select><select id="tBloc"><option>Pérenne</option><option>Saisonnier</option><option>Élevage</option><option>Divers</option></select></div><input id="tLib" placeholder="Ex : Arroser manguiers P2"><div class="row"><select id="tPerio"><option>Tous les jours</option><option>Tous les 2 jours</option><option>Chaque lundi</option><option>Chaque mois</option></select><input id="tHeure" placeholder="Heure : 07:00"></div><button class="b-green" onclick="addTache()">✅ + Assigner tâche</button></div><div id="listTaches"></div>
<div class="no-print"><h3>Paiement Ouvrier</h3><div class="row"><select id="pUser"></select><input id="pMontant" type="number" placeholder="Montant F"><input id="pMotif" placeholder="Motif : Salaire novembre"></div><button class="b-orange" onclick="addPaiement()">💰 Enregistrer paiement</button></div><div id="listPaiements"></div></div>
<div id="tab-agri" class="card tab" style="display:none"><h2>🌱 Agriculture - Parcelles + Cultures + Récoltes</h2>
<div class="no-print"><h3>Parcelle</h3><div class="row"><input id="parNom" placeholder="Parcelle : P1"><input id="parSurf" placeholder="Surface ha : 2"></div><button class="b-grey" onclick="addParcelle()">+ Ajouter parcelle</button><div id="listParcelle"></div>
<h3>Culture - Pérenne / Saisonnière</h3><div class="row"><select id="cuParcelle"></select><select id="cuType"><option>Pérenne</option><option>Saisonnière</option></select></div><div class="row"><input id="cuNom" placeholder="Manguier, Maïs, Manioc..."><input id="cuPieds" type="number" placeholder="Nombre pieds / Qté"></div><div class="row"><input id="cuSemis" type="date"><input id="cuRecoltePrev" type="date"></div><button class="b-green" onclick="addCulture()">🌱 + Ajouter culture</button></div><div id="listCultures"></div>
<div class="no-print"><h3>Entretien</h3><div class="row"><select id="eCu"></select><select id="eType"><option>Labour</option><option>Arrosage</option><option>Taille</option><option>Traitement</option><option>Désherbage</option></select></div><input id="eDesc" placeholder="Détail : ex Labour P3"><button class="b-blue" onclick="addEntretien()">+ Ajouter entretien</button></div><div id="listEntretiens"></div>
<div class="no-print"><h3>Récolte</h3><div class="row"><select id="rCu"></select><input id="rQte" type="number" placeholder="Quantité kg"><input id="rDate" type="date"></div><button class="b-orange" onclick="addRecolte()">🌾 + Ajouter récolte</button></div><div id="listRecoltes"></div></div>
<div id="tab-elevage" class="card tab" style="display:none"><h2>🐄 Élevage - 3 Familles</h2>
<div class="no-print"><div class="row"><select id="elFam"><option>Polygastriques</option><option>Monogastriques</option><option>Autres</option></select><select id="elEsp"><option>Bovins</option><option>Ovins</option><option>Caprins</option><option>Porcs</option><option>Volailles</option><option>Lapins</option><option>Poissons</option><option>Abeilles</option><option>Asticots</option></select></div><div class="row"><input id="elLot" placeholder="Lot : Lot A Vaches"><input id="elEff" type="number" placeholder="Effectif"></div><input id="elStock" type="number" placeholder="Stock aliment sacs : ex 10"><button class="b-blue" onclick="addLot()">🐄 + Ajouter lot</button></div><div id="listLots"></div>
<div class="no-print"><h3>Alimentation + Soin</h3><div class="row"><select id="alLot"></select><input id="alQte" placeholder="Ration : ex 2 sacs / jour"><input id="alDate" type="date"></div><button class="b-green" onclick="addAlim()">🥣 + Alimentation</button><div class="row"><input id="soinDesc" placeholder="Soin : Vaccin, Vermifuge"><input id="soinMort" type="number" placeholder="Mortalité : 0"></div><button class="b-orange" onclick="addSoin()">🩺 + Soin / Mortalité</button></div><div id="listAlimSoin"></div></div>
<div id="tab-compta" class="card tab" style="display:none"><h2>💰 Ventes & Compta</h2>
<div class="no-print"><div class="row"><select id="vType"><option>Récolte</option><option>Animal</option><option>Autre</option></select><input id="vProd" placeholder="Produit : Maïs, Porc, Mangue"></div><div class="row"><input id="vClient" placeholder="Client : Marché Maroua"><input id="vQte" type="number" placeholder="Quantité"><input id="vMontant" type="number" placeholder="Montant F"></div><button class="b-green" onclick="addVente()">💰 + Enregistrer vente</button><h3>Dépense</h3><div class="row"><input id="dDesc" placeholder="Dépense : Achat aliment"><input id="dMontant" type="number" placeholder="Montant F"></div><button class="b-red" onclick="addDepense()">➖ + Enregistrer dépense</button></div><div id="listVentes"></div><h3>Coût par lot (IA Argent)</h3><div id="coutLots"></div></div>
<div id="tab-journal" class="card tab" style="display:none"><h2>📓 Journal Mensuel</h2><div class="row no-print"><input id="jMois" type="month"><button class="b-blue" onclick="render()">Filtrer</button><button class="b-grey" onclick="window.print()">🖨️ Imprimer / PDF</button></div><div id="listJournal"></div></div>
<div id="tab-ia" class="card tab" style="display:none"><h2>🤖 IA Conseiller Boutou</h2><p class="small">Ex : "que doivent faire mes ouvriers demain ?" • "combien j'ai gagné ?" • "quelle parcelle est libre ?" • "quand récolter mon maïs ?" • "stock aliment porcs ?"</p><input id="qIA" placeholder="Écris ta question ici..."><button class="b-purple" style="width:100%" onclick="askIA()">🤖 Demander à l'IA</button><div id="repIA" class="ai2"></div><h3>🌦️ Météo Maroua - IA</h3><div id="meteoIA" class="ai">Chargement météo...</div><h3>🔍 Diagnostic Plante / Animal</h3><input id="diagTxt" placeholder="Décris : feuille jaune, porc ne mange pas..."><button class="b-orange" onclick="diagnostic()">🔍 Diagnostiquer</button><div id="diagRep" class="ai"></div></div>
<div id="vueOuvrier" class="card" style="display:none"><h2>👷 Mes tâches du jour</h2><p class="small">Tu ne vois que TES tâches.</p><div id="listMesTaches"></div><h3>📝 Mon historique</h3><div id="histOuvrier"></div></div>
</div></div>
<script>
// --- PWA : Installation ---
let deferredPrompt=null;
window.addEventListener('beforeinstallprompt',e=>{e.preventDefault(); deferredPrompt=e; document.getElementById('installBtn').style.display='block';});
function installerApp(){ if(deferredPrompt){ deferredPrompt.prompt(); deferredPrompt.userChoice.then(()=>{ deferredPrompt=null; document.getElementById('installBtn').style.display='none'; }); } else { alert('Sur Android Chrome : Menu ⋮ > Installer l\'application ou Ajouter à l\'écran d\'accueil. Sur iPhone : Partager > Ajouter à l\'écran d\'accueil.'); } }
if('serviceWorker' in navigator){ navigator.serviceWorker.register('sw.js').catch(()=>{}); }
function updateOnline(){ let b=document.getElementById('offlineBadge'); if(navigator.onLine){ b.textContent='🟢 En ligne'; } else { b.textContent='🟠 Hors-ligne - Ça marche quand même'; } }
window.addEventListener('online',updateOnline); window.addEventListener('offline',updateOnline); updateOnline();
// --- Données V8 - Schéma relationnel ---
let DB={parcelles:[{nom:'P1',surf:'2'},{nom:'P2',surf:'1.5'},{nom:'P3',surf:'3'}],cultures:[{parcelle:'P1',type:'Pérenne',nom:'Manguier',pieds:40,semis:'2024-03-10',recoltePrev:'2026-12-15'},{parcelle:'P3',type:'Saisonnière',nom:'Maïs',pieds:50,semis:'2026-10-01',recoltePrev:'2026-12-20'}],entretiens:[{culture:'Manguier',type:'Arrosage',desc:'Arrosage P1'}],recoltes:[{culture:'Maïs',qte:200,date:'2026-11-05'}],lots:[{fam:'Polygastriques',esp:'Bovins',lot:'Lot A - Vaches',eff:12,stock:10},{fam:'Monogastriques',esp:'Porcs',lot:'Lot Porcs',eff:18,stock:6},{fam:'Autres',esp:'Poissons',lot:'Étang 1',eff:500,stock:20},{fam:'Autres',esp:'Abeilles',lot:'Ruches P1',eff:8,stock:0}],alims:[],soins:[],users:[{nom:'Moussa',role:'Berger',code:'1111',actif:true},{nom:'Aïcha',role:'Champ',code:'2222',actif:true}],taches:[{user:'Moussa',bloc:'Élevage',lib:'Nourrir les porcs',perio:'Tous les jours',heure:'07:00'},{user:'Moussa',bloc:'Pérenne',lib:'Arroser les manguiers parcelle 2',perio:'Tous les 2 jours',heure:'08:00'},{user:'Aïcha',bloc:'Saisonnier',lib:'Désherber maïs P3',perio:'Chaque lundi',heure:'07:30'}],validations:[],paiements:[],ventes:[{type:'Récolte',prod:'Maïs',client:'Marché Maroua',qte:200,montant:80000,date:'2026-11-05'}],depenses:[{desc:'Achat aliment porcs',montant:45000,date:'2026-11-02'}]};
try{let s=localStorage.getItem('boutou_v8'); if(s) DB=JSON.parse(s);}catch(e){}
function save(){try{localStorage.setItem('boutou_v8',JSON.stringify(DB));}catch(e){}}
let current=null; function todayStr(){return new Date().toISOString().slice(0,10)}
function isDue(t,d){if(t.perio==='Tous les jours')return true; if(t.perio==='Tous les 2 jours')return new Date(d).getDate()%2===0; if(t.perio==='Chaque lundi')return new Date(d).getDay()===1; if(t.perio==='Chaque mois')return new Date(d).getDate()===1; return true;}
function v(id){return document.getElementById(id).value.trim();}
function doLogin(){let c=v('code'); if(c==='9999') current={nom:'Gestionnaire',role:'Gestionnaire',code:'9999'}; else{let u=DB.users.find(x=>x.code===c&&x.actif); if(!u) return alert('Code inconnu ou bloqué.'); current=u;} document.getElementById('login').style.display='none'; document.getElementById('app').style.display='block'; document.getElementById('who').textContent='Bonjour '+current.nom+' • '+current.role; document.getElementById('whoSub').textContent=current.role==='Gestionnaire'?'Tu contrôles tout Boutou - V8 Logiciel Libre':'Code : '+current.code+' - Tu ne vois que tes tâches'; if(current.role==='Gestionnaire'){document.getElementById('tabsManager').style.display='flex'; document.querySelectorAll('.tab').forEach(e=>e.style.display='none'); document.getElementById('tab-dash').style.display='block'; document.getElementById('vueOuvrier').style.display='none';} else{document.getElementById('tabsManager').style.display='none'; document.querySelectorAll('.tab').forEach(e=>e.style.display='none'); document.getElementById('vueOuvrier').style.display='block';} render();}
function logout(){location.reload();}
function showTab(id,btn){document.querySelectorAll('.tabs button').forEach(b=>b.classList.remove('on')); btn.classList.add('on'); document.querySelectorAll('.tab').forEach(e=>e.style.display='none'); document.getElementById('tab-'+id).style.display='block'; render();}
function addUser(){let n=v('uNom'); if(!n) return alert('Nom'); let code=String(Math.floor(1000+Math.random()*9000)); DB.users.push({nom:n,role:v('uRole')||'Ouvrier',code,actif:true}); save(); render(); alert('Ouvrier : '+n+' - Code : '+code);}
function addTache(){let o={user:v('tUser'),bloc:v('tBloc'),lib:v('tLib'),perio:v('tPerio'),heure:v('tHeure')}; if(!o.lib) return alert('Tâche'); DB.taches.push(o); save(); render();}
function addPaiement(){let o={user:v('pUser'),montant:Number(v('pMontant')||0),motif:v('pMotif'),date:todayStr()}; DB.paiements.push(o); DB.depenses.push({desc:'Paiement '+o.user+' - '+o.motif,montant:o.montant,date:o.date}); save(); render();}
function addParcelle(){DB.parcelles.push({nom:v('parNom'),surf:v('parSurf')}); save(); render();}
function addCulture(){DB.cultures.push({parcelle:v('cuParcelle'),type:v('cuType'),nom:v('cuNom'),pieds:v('cuPieds'),semis:v('cuSemis'),recoltePrev:v('cuRecoltePrev')}); save(); render();}
function addEntretien(){DB.entretiens.push({culture:v('eCu'),type:v('eType'),desc:v('eDesc')}); save(); render();}
function addRecolte(){DB.recoltes.push({culture:v('rCu'),qte:Number(v('rQte')||0),date:v('rDate')||todayStr()}); save(); render();}
function addLot(){DB.lots.push({fam:v('elFam'),esp:v('elEsp'),lot:v('elLot'),eff:Number(v('elEff')||0),stock:Number(v('elStock')||0)}); save(); render();}
function addAlim(){let lot=v('alLot'); DB.alims.push({lot,qte:v('alQte'),date:v('alDate')||todayStr()}); let L=DB.lots.find(x=>x.lot===lot); if(L) L.stock=Math.max(0,(L.stock||0)-1); save(); render();}
function addSoin(){DB.soins.push({lot:v('alLot'),desc:v('soinDesc'),mort:Number(v('soinMort')||0),date:todayStr()}); let L=DB.lots.find(x=>x.lot===v('alLot')); if(L) L.eff=Math.max(0,L.eff-Number(v('soinMort')||0)); save(); render();}
function addVente(){DB.ventes.push({type:v('vType'),prod:v('vProd'),client:v('vClient'),qte:Number(v('vQte')||0),montant:Number(v('vMontant')||0),date:todayStr()}); save(); render();}
function addDepense(){DB.depenses.push({desc:v('dDesc'),montant:Number(v('dMontant')||0),date:todayStr()}); save(); render();}
function del(arr,i){if(!confirm('Supprimer ?'))return; DB[arr].splice(i,1); save(); render();}
function toggleUser(i){DB.users[i].actif=!DB.users[i].actif; save(); render();}
function regenCode(i){let c=String(Math.floor(1000+Math.random()*9000)); DB.users[i].code=c; save(); render(); alert('Nouveau code '+DB.users[i].nom+' : '+c);}
function askIA(){let q=v('qIA').toLowerCase(); let r=''; let rec=DB.ventes.reduce((a,x)=>a+x.montant,0); let dep=DB.depenses.reduce((a,x)=>a+x.montant,0); if(q.includes('demain')||q.includes('ouvrier')||q.includes('tâche')||q.includes('tache')) r='🤖 Demain, tes ouvriers doivent faire : '+DB.taches.map(t=>t.user+' → '+t.lib+' ('+t.perio+')').join(' • '); else if(q.includes('gagné')||q.includes('bénéfice')||q.includes('argent')||q.includes('solde')) r='🤖 Recettes '+rec+' F, Dépenses '+dep+' F, Solde = '+(rec-dep)+' F.'; else if(q.includes('parcelle')&&q.includes('libre')){let occ=DB.cultures.map(c=>c.parcelle); let libres=DB.parcelles.filter(p=>!occ.includes(p.nom)); r='🤖 Parcelles libres : '+(libres.length?libres.map(p=>p.nom).join(', '):'Aucune, toutes occupées.');} else if(q.includes('maïs')||q.includes('recolter')||q.includes('récolte')){let c=DB.cultures.find(x=>x.nom.toLowerCase().includes('maïs')||x.nom.toLowerCase().includes('mais')); r=c?'🤖 Maïs semé le '+c.semis+' sur '+c.parcelle+', récolte prévue '+c.recoltePrev+'. Prépare sacs 3 jours avant.':'🤖 Pas de maïs enregistré.';} else if(q.includes('stock')||q.includes('aliment')||q.includes('porc')){let l=DB.lots.find(x=>x.esp==='Porcs'); r=l?'🤖 Stock Porcs : '+l.stock+' sacs, effectif '+l.eff+'. À 2 sacs/jour, reste '+Math.floor(l.stock/2)+' jours.':'🤖 Aucun lot porcs.';} else r='🤖 Je connais tes données : '+DB.cultures.length+' cultures, '+DB.lots.length+' lots, '+DB.users.length+' ouvriers. Demande-moi : tâches demain, argent gagné, parcelle libre, récolte maïs, stock porcs.'; document.getElementById('repIA').innerHTML=r;}
function diagnostic(){let t=v('diagTxt').toLowerCase(); let r=''; if(t.includes('feuille')&&t.includes('jaune')) r='🔍 Feuille jaune = manque d\'eau ou d\'azote. Vérifie arrosage, apporte compost.'; else if(t.includes('porc')&&t.includes('mange')) r='🔍 Porc qui ne mange pas = vérifie eau, chaleur, vermifuge. Si 2 jours sans manger, appelle vétérinaire.'; else if(t.includes('poule')||t.includes('poussin')) r='🔍 Vérifie chaleur, eau propre, aliment. Mortalité >3 en 2 jours = alerte.'; else r='🔍 Décris plus : plante ou animal ? Symptôme ? Depuis quand ?'; document.getElementById('diagRep').innerHTML=r;}
function render(){ document.getElementById('cPer').textContent=DB.cultures.filter(c=>c.type==='Pérenne').length; document.getElementById('cSai').textContent=DB.cultures.filter(c=>c.type==='Saisonnière').length; document.getElementById('cEle').textContent=DB.lots.length; document.getElementById('cPers').textContent=DB.users.length; let rec=DB.ventes.reduce((a,x)=>a+x.montant,0); let dep=DB.depenses.reduce((a,x)=>a+x.montant,0); document.getElementById('cSolde').textContent=(rec-dep).toLocaleString()+' F'; document.getElementById('resumeIA').innerHTML='Tu as gagné <b>'+rec.toLocaleString()+' F</b>, dépensé <b>'+dep.toLocaleString()+' F</b>. Solde : <b>'+(rec-dep).toLocaleString()+' F</b>. '+(rec>dep?'✅ Bon mois.':'⚠️ Dépenses supérieures.'); let ai=document.getElementById('aiBox'), ai2=document.getElementById('aiAlertBox'); if(current&&current.role!=='Gestionnaire'){let dues=DB.taches.filter(t=>t.user===current.nom&&isDue(t,todayStr())); ai.innerHTML='<b>🤖 Rappel IA pour '+current.nom+'</b><br>Bonjour '+current.nom+', aujourd\'hui tu as <b>'+dues.length+' tâche(s)</b> : '+dues.map(d=>d.lib).join(' • '); ai2.innerHTML='💡 Valide chaque tâche avec une description.';} else if(current){let dues=DB.taches.filter(t=>isDue(t,todayStr())); let faits=DB.validations.filter(x=>x.date===todayStr()&&x.statut==='Fait').length; ai.innerHTML='<b>🤖 IA Gestionnaire</b><br>Aujourd\'hui : <b>'+dues.length+' tâches</b> • Validées : <b>'+faits+'</b> • En attente : <b>'+(dues.length-faits)+'</b>'; let alerts=[]; DB.lots.forEach(l=>{if((l.stock||0)<=3) alerts.push('⚠️ Stock faible : '+l.lot+' - plus que '+l.stock+' sacs.'); if(l.esp==='Poissons') alerts.push('🐟 Chaleur à Maroua, vérifie oxygène étang.'); if(l.esp==='Abeilles') alerts.push('🐝 Floraison manguiers, vérifie ruches dans 7 jours.'); if(l.esp==='Asticots') alerts.push('🪱 Asticots : maturité dans 3 jours.');}); let mortTot=DB.soins.reduce((a,x)=>a+(x.mort||0),0); if(mortTot>=3) alerts.push('🚨 Mortalité '+mortTot+' - vérifie vétérinaire.'); ai2.innerHTML='<b>🤖 Alertes IA</b><br>'+(alerts.length?alerts.join('<br>'):'✅ Aucune alerte critique.');} document.getElementById('meteoIA').innerHTML='🌦️ <b>Météo Maroua (IA) :</b> Saison sèche / chaude. Arrose tôt le matin 6h-8h. Si pluie demain, ne pas arroser P2/P3.'; document.getElementById('listPers').innerHTML=DB.users.map((u,i)=>'<div class="item"><b>'+u.nom+'</b> - '+u.role+' • Code : <b>'+u.code+'</b> • '+(u.actif?'✅ Actif':'🔒 Bloqué')+'<br><button class="b-blue" onclick="regenCode('+i+')">🔑 Nouveau code</button> <button class="b-grey" onclick="toggleUser('+i+')">'+(u.actif?'🔒 Bloquer':'✅ Débloquer')+'</button> <button class="b-red" onclick="del(\'users\','+i+')">🗑 Supprimer</button></div>').join(''); let sel=document.getElementById('tUser'); if(sel) sel.innerHTML=DB.users.map(u=>'<option>'+u.nom+'</option>').join(''); let sel2=document.getElementById('pUser'); if(sel2) sel2.innerHTML=DB.users.map(u=>'<option>'+u.nom+'</option>').join(''); document.getElementById('listTaches').innerHTML=DB.taches.map((t,i)=>'<div class="item"><b>'+t.lib+'</b> - '+t.user+' • '+t.bloc+' • '+t.perio+' • '+t.heure+' <button class="b-red" onclick="del(\'taches\','+i+')">🗑 Supprimer</button></div>').join('')||'Aucune tâche.'; document.getElementById('listPaiements').innerHTML=DB.paiements.map(p=>'<div class="item"><b>'+p.user+'</b> - '+p.montant+' F - '+p.motif+' - '+p.date+'</div>').join('')||'Aucun paiement.'; document.getElementById('listParcelle').innerHTML=DB.parcelles.map((p,i)=>'<div class="item"><b>'+p.nom+'</b> - '+p.surf+' ha <button class="b-red" onclick="del(\'parcelles\','+i+')">🗑</button></div>').join(''); let cp=document.getElementById('cuParcelle'); if(cp) cp.innerHTML=DB.parcelles.map(p=>'<option>'+p.nom+'</option>').join(''); document.getElementById('listCultures').innerHTML=DB.cultures.map((c,i)=>'<div class="item"><b>'+c.nom+'</b> <span class="badge">'+c.type+'</span> <span class="badge-orange badge">'+c.parcelle+'</span><br><span class="small">Semis : '+c.semis+' • Pieds/Qté : '+c.pieds+' • 🤖 Récolte prévue '+c.recoltePrev+'</span><br><button class="b-red" onclick="del(\'cultures\','+i+')">🗑 Supprimer</button></div>').join('')||'Aucune culture.'; let ec=document.getElementById('eCu'); if(ec) ec.innerHTML=DB.cultures.map(c=>'<option>'+c.nom+'</option>').join(''); let rc=document.getElementById('rCu'); if(rc) rc.innerHTML=DB.cultures.map(c=>'<option>'+c.nom+'</option>').join(''); document.getElementById('listEntretiens').innerHTML=DB.entretiens.map(e=>'<div class="item"><b>'+e.culture+'</b> - '+e.type+' - '+e.desc+'</div>').join('')||'Aucun entretien.'; document.getElementById('listRecoltes').innerHTML=DB.recoltes.map(r=>'<div class="item"><b>'+r.culture+'</b> - '+r.qte+' kg - '+r.date+'</div>').join('')||'Aucune récolte.'; document.getElementById('listLots').innerHTML=DB.lots.map((l,i)=>'<div class="item"><b>'+l.lot+'</b> <span class="badge">'+l.fam+'</span> <span class="badge-orange badge">'+l.esp+'</span><br><span class="small">Effectif : '+l.eff+' • Stock : '+l.stock+' sacs '+(l.stock<=3?'⚠️ Stock faible':'')+'</span><br><button class="b-red" onclick="del(\'lots\','+i+')">🗑 Supprimer</button></div>').join('')||'Aucun lot.'; let al=document.getElementById('alLot'); if(al) al.innerHTML=DB.lots.map(l=>'<option>'+l.lot+'</option>').join(''); document.getElementById('listAlimSoin').innerHTML='<b>Alimentations :</b><br>'+DB.alims.map(a=>'<div class="item">'+a.lot+' - '+a.qte+' - '+a.date+'</div>').join('')+'<b>Soins :</b><br>'+DB.soins.map(s=>'<div class="item">'+s.lot+' - '+s.desc+' - Mortalité : '+s.mort+' - '+s.date+'</div>').join('')||'Aucun.'; document.getElementById('listVentes').innerHTML=DB.ventes.map(vv=>'<div class="item">💰 Vente : <b>'+vv.prod+'</b> - '+vv.qte+' - '+vv.montant+' F - '+vv.client+' - '+vv.date+'</div>').join('')+DB.depenses.map(d=>'<div class="item">➖ Dépense : '+d.desc+' - '+d.montant+' F - '+d.date+'</div>').join(''); document.getElementById('coutLots').innerHTML=DB.lots.map(l=>'<div class="item"><b>'+l.lot+'</b> : Coût estimé aliment restant '+(l.stock*15000).toLocaleString()+' F • Effectif '+l.eff+'</div>').join(''); let today=todayStr(); document.getElementById('dashToday').innerHTML=DB.users.map(u=>{let vs=DB.validations.filter(x=>x.user===u.nom&&x.date===today); return '<div class="item"><b>'+u.nom+'</b> : '+(vs.length?vs.map(x=>x.lib+' - '+x.statut+' - "'+x.desc+'"').join('<br>'):'<span style="color:#C62828">❌ Rien validé aujourd\'hui</span>')+'</div>'}).join(''); let mois=document.getElementById('jMois').value||today.slice(0,7); let j=DB.validations.filter(x=>x.date.startsWith(mois)); let vMois=DB.ventes.filter(x=>x.date.startsWith(mois)); let dMois=DB.depenses.filter(x=>x.date.startsWith(mois)); document.getElementById('listJournal').innerHTML='<p class="small">Mois : '+mois+' • Validations : '+j.length+' • Ventes : '+vMois.length+' • Dépenses : '+dMois.length+'</p>'+j.map(x=>'<div class="item"><b>'+x.date+'</b> - '+x.user+' - '+x.lib+' - '+x.statut+' - "'+x.desc+'"</div>').join('')+vMois.map(x=>'<div class="item">💰 Vente '+x.prod+' - '+x.montant+' F</div>').join('')+dMois.map(x=>'<div class="item">➖ Dépense '+x.desc+' - '+x.montant+' F</div>').join('')||'Aucune donnée.'; if(current&&current.role!=='Gestionnaire'){let dues=DB.taches.filter(t=>t.user===current.nom&&isDue(t,today)); document.getElementById('listMesTaches').innerHTML=dues.map((t,i)=>{let idx=DB.taches.indexOf(t); return '<div class="item"><b>'+t.lib+'</b> • '+t.bloc+' • '+t.perio+' • '+t.heure+'<br><textarea id="desc'+idx+'" placeholder="Décris autrement : ex J\'ai arrosé mais tuyau percé"></textarea><div class="row"><button class="b-green" onclick="valider('+idx+',\'Fait\')">✅ Fait</button><button class="b-grey" onclick="valider('+idx+',\'Pas fait\')">❌ Pas fait</button></div></div>'}).join('')||'Aucune tâche aujourd\'hui.'; document.getElementById('histOuvrier').innerHTML=DB.validations.filter(x=>x.user===current.nom).slice(-10).reverse().map(x=>'<div class="item">'+x.date+' - '+x.lib+' - '+x.statut+' - "'+x.desc+'"</div>').join('')||'Aucun historique.';}}
function valider(idx,statut){let t=DB.taches[idx]; let desc=document.getElementById('desc'+idx).value||'Aucune précision'; DB.validations.push({date:todayStr(),user:current.nom,lib:t.lib,statut,desc}); save(); render(); alert('Merci '+current.nom+', validé : '+t.lib+' - '+statut);}
</script>
</body></html>